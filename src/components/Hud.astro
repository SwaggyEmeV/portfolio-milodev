---
// HUD fijo: barra de progreso arriba y tacómetro abajo a la derecha.
// Las rpm suben al hacer scroll rápido y la marcha cambia en cada sección.
// Lo mueve src/scripts/efectos.ts (función hud).
const marcas = Array.from({ length: 13 }, (_, i) => {
  const ang = ((-120 + i * 20) * Math.PI) / 180; // de -120° a +120°, cada 1000 rpm
  const r1 = i % 2 === 0 ? 40 : 43;
  return {
    x1: 60 + Math.sin(ang) * r1, y1: 60 - Math.cos(ang) * r1,
    x2: 60 + Math.sin(ang) * 46, y2: 60 - Math.cos(ang) * 46,
    num: i % 2 === 0 ? i : null,
    nx: 60 + Math.sin(ang) * 33, ny: 60 - Math.cos(ang) * 33 + 2.5,
    roja: i >= 10,
  };
});
---

<div data-progreso class="fixed top-0 left-0 z-40 h-0.5 w-full origin-left bg-portal shadow-[0_0_10px] shadow-portal" style="scale: 0 1"></div>

<div
  data-tacometro
  aria-hidden="true"
  class="tacometro pointer-events-none fixed right-2 bottom-2 z-30 w-[72px] rounded-full border border-borde bg-asfalto/70 p-1 backdrop-blur sm:right-5 sm:bottom-5 sm:w-32"
>
  <svg viewBox="0 0 120 120" class="w-full">
    <!-- arco de fondo, zona roja y arco que se llena -->
    <path d="M18.43 84 A48 48 0 1 1 101.57 84" fill="none" stroke="var(--color-borde)" stroke-width="5" stroke-linecap="round" />
    <path d="M107.27 51.66 A48 48 0 0 1 101.57 84" fill="none" stroke="#ef4444" stroke-width="5" stroke-linecap="round" opacity="0.7" />
    <path data-arco d="M18.43 84 A48 48 0 1 1 101.57 84" fill="none" stroke="var(--color-portal)" stroke-width="5" stroke-linecap="round" class="arco-rpm" />
    {marcas.map((m) => (
      <>
        <line x1={m.x1} y1={m.y1} x2={m.x2} y2={m.y2} stroke={m.roja ? "#ef4444" : "var(--color-humo)"} stroke-width="1.2" />
        {m.num !== null && (
          <text x={m.nx} y={m.ny} text-anchor="middle" font-size="7" font-family="JetBrains Mono, monospace" fill={m.roja ? "#ef4444" : "var(--color-humo)"}>{m.num}</text>
        )}
      </>
    ))}
    <!-- aguja: gira alrededor del centro (60,60) -->
    <g data-aguja class="aguja">
      <line x1="60" y1="66" x2="60" y2="20" stroke="var(--color-motor)" stroke-width="2.2" stroke-linecap="round" />
    </g>
    <circle cx="60" cy="60" r="4" fill="var(--color-motor)" />
    <text data-marcha x="60" y="88" text-anchor="middle" font-size="18" font-weight="700" font-family="JetBrains Mono, monospace" fill="var(--color-portal)" class="marcha">N</text>
    <text x="60" y="104" text-anchor="middle" font-size="7" font-family="JetBrains Mono, monospace" fill="var(--color-humo)"><tspan data-rpm>1100</tspan> rpm</text>
  </svg>
</div>

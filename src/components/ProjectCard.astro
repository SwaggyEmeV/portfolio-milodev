---
interface Props {
  slug: string;
  titulo: string;
  resumen: string;
  tecnologias: string[];
  destacado?: boolean;
}
const { slug, titulo, resumen, tecnologias, destacado = false } = Astro.props;
---

<!-- "group" deja que los hijos reaccionen al hover de la tarjeta (group-hover:) -->
<!-- data-tilt: inclinación 3D al pasar el ratón (script en Layout.astro) -->
<a
  href={`/proyectos/${slug}/`}
  data-tilt
  data-reveal
  class="group relative flex flex-col rounded-xl border border-borde bg-chasis/75 p-6 backdrop-blur-md transition-[border-color,box-shadow] duration-300 hover:border-portal/60 hover:shadow-[0_0_30px_-10px] hover:shadow-portal/40"
>
  <span class="brillo"></span>
  <div class="flex items-center justify-between font-mono text-xs text-humo">
    <span>./{slug}</span>
    {destacado && <span class="rounded border border-motor/40 px-2 py-0.5 text-motor">destacado</span>}
  </div>
  <h3 class="mt-4 text-lg font-semibold text-white transition group-hover:text-portal">{titulo}</h3>
  <p class="mt-2 flex-1 text-humo">{resumen}</p>
  <ul class="mt-5 flex flex-wrap gap-2 font-mono text-xs">
    {tecnologias.map((t) => (
      <li class="rounded bg-asfalto px-2 py-1 text-portal/90">{t}</li>
    ))}
  </ul>
  <span class="mt-5 font-mono text-sm text-humo transition group-hover:text-portal">ver_más →</span>
</a>

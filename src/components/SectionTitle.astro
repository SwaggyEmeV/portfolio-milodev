---
// Título de sección con estilo de comentario de código: "// 01. proyectos"
interface Props {
  numero: string;
  titulo: string;
}
const { numero, titulo } = Astro.props;
---

<h2 data-reveal class="flex items-center gap-4 font-mono text-2xl font-bold text-white sm:text-3xl">
  <!-- data-descifrar: el título aparece "descifrándose" al hacer scroll -->
  <span><span class="text-portal">// {numero}.</span> <span data-descifrar>{titulo}</span></span>
  <span aria-hidden="true" class="h-px flex-1 bg-borde"></span>
</h2>

---
// Iconos SVG dibujados a mano (sin librerías). "currentColor" hace que
// tomen el color del texto, así que se colorean con clases como text-portal.
interface Props {
  name: "moto" | "llave" | "portal" | "terminal";
  class?: string;
}
const { name, class: className = "h-6 w-6" } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === "moto" && (
    <>
      <circle cx="5" cy="16" r="3.5" />
      <circle cx="19" cy="16" r="3.5" />
      <path d="M5 16l4-7h5l3 7" />
      <path d="M14 9l1.5-3H18" />
      <path d="M9 9l2 4h4" />
    </>
  )}
  {name === "llave" && (
    <path d="M14.7 6.3a4 4 0 0 0-5.4 5.2L3.6 17.2a1.6 1.6 0 0 0 2.3 2.3l5.7-5.7a4 4 0 0 0 5.2-5.4l-2.5 2.5-2.2-.4-.4-2.2z" />
  )}
  {name === "portal" && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M12 6a6 6 0 1 1-6 6" />
      <path d="M12 9a3 3 0 1 1-3 3" />
    </>
  )}
  {name === "terminal" && (
    <>
      <rect x="3" y="4" width="18" height="16" rx="2" />
      <path d="M7 9l3 3-3 3" />
      <path d="M13 15h4" />
    </>
  )}
</svg>

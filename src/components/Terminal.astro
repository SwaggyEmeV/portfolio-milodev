---
// El home es una terminal que el SCROLL maneja. Este componente pinta el
// marco (fondo, palabra gigante, riel de progreso, ventana, HUD, barra tmux)
// y le pasa los datos a los scripts:
//   src/scripts/terminal.ts  -> el shell: comandos, archivos, salida
//   src/scripts/escenario.ts -> scroll, efectos y tacómetro
import type { CollectionEntry } from "astro:content";
import Barra from "./Barra.astro";
import { site, tabs } from "../data/site";

interface Props {
  proyectos: CollectionEntry<"proyectos">[];
}
const { proyectos } = Astro.props;

// Datos que necesita la terminal en el navegador (se incrustan como JSON)
const datos = {
  usuario: site.usuario,
  nombre: site.nombre,
  rol: site.rol,
  frase: site.frase,
  email: site.email,
  github: site.github,
  linkedin: site.linkedin,
  sobreMi: site.sobreMi,
  ficha: site.ficha,
  tecnologias: site.tecnologias,
  intereses: site.intereses,
  tabs,
  proyectos: proyectos.map((p) => ({
    slug: p.id,
    titulo: p.data.titulo,
    resumen: p.data.resumen,
    tecnologias: p.data.tecnologias,
    destacado: p.data.destacado,
    demo: p.data.demo,
    repo: p.data.repo,
    cuerpo: p.body ?? "",
  })),
};
// "<" escapado para que ningún texto pueda cerrar la etiqueta <script>
const datosJson = JSON.stringify(datos).replace(/</g, "\\u003c");

// Palabra gigante de fondo de cada etapa (una por tramo de scroll)
const fantasmas = [["Miller", "Ochoa"], ["Proyectos"], ["Sobre", "mí"], ["Garaje"], ["Contacto"]];
const nombresEtapa = ["home", "proyectos", "sobre_mí", "garaje", "contacto"];

// Árbol del explorador: cada nodo ejecuta un comando al pulsarlo
type Nodo = { etiqueta: string; cmd: string; dir?: boolean };
const rama = (i: number, total: number) => (i === total - 1 ? "└" : "├");
const arbol: Nodo[] = [
  { etiqueta: "├── proyectos/", cmd: "cd ~/proyectos", dir: true },
  ...proyectos.map((p, i) => ({
    etiqueta: `│   ${rama(i, proyectos.length)}── ${p.id}.md`,
    cmd: `cat ~/proyectos/${p.id}.md`,
  })),
  { etiqueta: "├── garaje/", cmd: "cd ~/garaje", dir: true },
  ...site.intereses.map((it, i) => ({
    etiqueta: `│   ${rama(i, site.intereses.length)}── ${it.archivo}`,
    cmd: `cat ~/garaje/${it.archivo}`,
  })),
  { etiqueta: "├── sobre_mi.md", cmd: "cat ~/sobre_mi.md" },
  { etiqueta: "├── stack.txt", cmd: "cat ~/stack.txt" },
  { etiqueta: "└── contacto.sh", cmd: "cat ~/contacto.sh" },
];

const atajos = ["neofetch", "ps aux", "cat ~/sobre_mi.md", "contacto", "rev"];

// Marcas del tacómetro: de -120° a +120°, cada 20°. Las últimas, en zona roja.
const marcas = Array.from({ length: 13 }, (_, i) => {
  const grados = -120 + i * 20;
  const rad = (grados * Math.PI) / 180;
  const punto = (r: number) => ({ x: +(80 + r * Math.sin(rad)).toFixed(1), y: +(80 - r * Math.cos(rad)).toFixed(1) });
  const fuera = punto(i % 3 === 0 ? 52 : 55);
  const dentro = punto(60);
  return { x1: fuera.x, y1: fuera.y, x2: dentro.x, y2: dentro.y, roja: grados >= 70 };
});
---

<h1 class="sr-only">{site.nombre} · {site.rol}</h1>

<div class="escenario" data-escenario data-etapa-actual="0">
  <div class="stage escenario-ui">
    <!-- ===== FONDO ===== -->
    <div class="fondo" aria-hidden="true">
      <div class="foco"></div>
      <div class="suelo"><div class="suelo-plano"></div></div>
      <div class="ruido"></div>
      <div class="barrido"></div>
      <div class="vineta"></div>
    </div>

    <!-- ===== PALABRA GIGANTE (cambia con cada etapa) ===== -->
    <div class="ghosts" aria-hidden="true">
      {fantasmas.map((lineas, i) => (
        <span class:list={["ghost", i === 0 && "activa"]} data-ghost={i}>
          {lineas.map((l) => <span>{l}</span>)}
        </span>
      ))}
    </div>

    <!-- ===== RIEL DE PROGRESO ===== -->
    <nav class="riel" aria-label="Progreso de la página">
      <div class="riel-pista"><div class="riel-relleno" data-riel-relleno></div></div>
      <ol class="riel-lista">
        {nombresEtapa.map((n, i) => (
          <li>
            <button type="button" class:list={["paso", i === 0 && "activa"]} data-paso={i} data-ir={i} aria-current={i === 0 ? "step" : "false"}>
              <span class="paso-n">0{i}</span><span class="paso-t">{n}</span>
            </button>
          </li>
        ))}
      </ol>
    </nav>

    <!-- ===== VENTANA DE LA TERMINAL ===== -->
    <div class="cuerpo">
      <section class="ventana" data-ventana aria-label="Terminal">
        <header class="ventana-cab">
          <span class="puntos" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="ventana-titulo">{site.usuario}@garaje — zsh</span>
          <span class="ventana-readout" data-readout aria-hidden="true">N · 1100 rpm</span>
        </header>

        <div class="ventana-cuerpo">
          <aside class="explorador" aria-label="Explorador de archivos">
            <p class="mx-2 mb-2 text-xs text-humo">~/{site.usuario}</p>
            {arbol.map((n) => (
              <button type="button" class:list={["run", n.dir && "run-dir"]} data-cmd={n.cmd}>{n.etiqueta}</button>
            ))}
            <p class="mx-2 mt-4 text-xs leading-relaxed text-humo">
              clic en carpeta = cd<br />clic en archivo = cat
            </p>
          </aside>

          <div class="term" data-t-panel>
            <div class="term-scroll" data-t-scroll role="log" aria-live="off" aria-label="Salida de la terminal" tabindex="0">
              <div data-t-salida></div>
            </div>

            <div class="chips">
              <span class="shrink-0 text-xs text-humo">prueba:</span>
              {atajos.map((c) => <button type="button" class="chip" data-cmd={c}>{c}</button>)}
            </div>

            <label class="prompt-row">
              <span class="whitespace-nowrap text-agua" data-t-prompt>{site.usuario}@garaje:~$</span>
              <input
                class="term-input"
                type="text"
                data-t-input
                aria-label="Línea de comandos"
                autocomplete="off"
                autocapitalize="off"
                spellcheck="false"
                placeholder="escribe help…"
              />
            </label>
          </div>
        </div>
      </section>
    </div>

    <!-- ===== HUD: TACÓMETRO, SERVICIOS E HISTORIAL ===== -->
    <aside class="hud" aria-label="Estado del sistema">
      <div class="vidrio">
        <p class="lbl">motor</p>
        <svg viewBox="0 0 160 130" class="gauge" role="img" aria-label="Tacómetro: sube con la velocidad del scroll">
          <path d="M 24.6 112 A 64 64 0 1 1 135.4 112" class="gauge-pista"></path>
          <path d="M 24.6 112 A 64 64 0 1 1 135.4 112" class="gauge-arco" data-g-arco></path>
          {marcas.map((m) => <line x1={m.x1} y1={m.y1} x2={m.x2} y2={m.y2} class:list={["gauge-tick", m.roja && "roja"]}></line>)}
          <g class="gauge-aguja" data-g-aguja>
            <line x1="80" y1="80" x2="80" y2="36"></line>
            <circle cx="80" cy="80" r="5"></circle>
          </g>
        </svg>
        <div class="gauge-datos">
          <span class="gauge-rpm" data-g-rpm>1100</span><span class="text-xs text-humo"> rpm</span>
          <span class="gauge-marcha"><b data-g-marcha>N</b> <span data-g-nombre>home</span></span>
        </div>
      </div>

      <div class="vidrio text-[13px] leading-[1.9]">
        <p class="lbl">servicios</p>
        <div>● nginx <span class="text-humo">· active</span></div>
        <div>● mysql <span class="text-humo">· active</span></div>
        <div>● php-fpm <span class="text-humo">· active</span></div>
        <div><span class="text-motor">●</span> café <span class="text-humo">· bajo</span></div>
      </div>

      <div class="vidrio">
        <p class="lbl">historial · <span data-t-cuenta>0</span></p>
        <div class="text-[13px] leading-[1.8] text-humo" data-t-historial>—</div>
      </div>
    </aside>

    <div class="cue" aria-hidden="true">↓ scroll</div>
    <Barra interactiva activa={0} />
  </div>
</div>

<!-- Resumen en HTML normal: lo leen buscadores y lectores de pantalla (y se ve si no hay JavaScript) -->
<section class="resumen">
  <p>{site.frase}</p>
  <h2>Proyectos</h2>
  <ul>
    {proyectos.map((p) => (
      <li>
        <a href={`/proyectos/${p.id}`}>{p.data.titulo}</a> — {p.data.resumen}
      </li>
    ))}
  </ul>
  <h2>Sobre mí</h2>
  {site.sobreMi.map((t) => <p>{t}</p>)}
  <h2>Contacto</h2>
  <p>
    <a href={`mailto:${site.email}`}>{site.email}</a> · <a href={site.github}>GitHub</a> · <a href={site.linkedin}>LinkedIn</a>
  </p>
</section>

<script type="application/json" id="datos-terminal" set:html={datosJson} />

<script>
  import "../scripts/escenario";
</script>

---
// Escena 3D del hero: dos engranajes en "wireframe" (líneas) que giran
// engranados, rodeados de un vórtice de partículas tipo portal.
// El <script> de abajo se ejecuta en el NAVEGADOR (no al compilar):
// Astro lo empaqueta automáticamente junto con Three.js.
---

<div class="relative h-full w-full" data-hero3d>
  <canvas class="h-full w-full" aria-hidden="true"></canvas>
  <!-- Pista para el usuario; desaparece en móvil -->
  <p class="pointer-events-none absolute right-2 bottom-2 hidden font-mono text-xs text-humo/70 lg:block">
    // mueve el ratón
  </p>
</div>

<script>
  // Importamos solo las piezas de Three.js que usamos (así pesa menos).
  import {
    WebGLRenderer, Scene, PerspectiveCamera, Group, Shape, Path,
    ExtrudeGeometry, EdgesGeometry, LineSegments, LineBasicMaterial,
    Mesh, MeshBasicMaterial, BufferGeometry, Float32BufferAttribute,
    Points, PointsMaterial, AdditiveBlending, Color,
  } from "three";

  // Colores de la paleta (los mismos que en global.css)
  const VERDE = 0x4ade80;
  const NARANJA = 0xfb923c;
  const ASFALTO = 0x0a0f0c;

  const contenedor = document.querySelector<HTMLElement>("[data-hero3d]");
  const canvas = contenedor?.querySelector("canvas");

  /**
   * Dibuja el perfil 2D de un engranaje (dientes + agujero central)
   * y lo "extruye" (le da grosor) para convertirlo en 3D.
   */
  function crearEngranaje(dientes: number, radio: number, profDiente: number, grosor: number) {
    const forma = new Shape();
    const pasos = dientes * 4; // cada diente: subida, cima, bajada, valle
    for (let i = 0; i <= pasos; i++) {
      const angulo = (i / pasos) * Math.PI * 2;
      const fase = i % 4;
      const r = fase === 1 || fase === 2 ? radio + profDiente : radio;
      const x = Math.cos(angulo) * r;
      const y = Math.sin(angulo) * r;
      i === 0 ? forma.moveTo(x, y) : forma.lineTo(x, y);
    }
    // Agujero central
    const agujero = new Path();
    agujero.absarc(0, 0, radio * 0.35, 0, Math.PI * 2, true);
    forma.holes.push(agujero);

    const geo = new ExtrudeGeometry(forma, { depth: grosor, bevelEnabled: false, curveSegments: 24 });
    geo.center();
    return geo;
  }

  /** Un engranaje = cuerpo oscuro (tapa las líneas de atrás) + aristas de color. */
  function engranaje(dientes: number, radio: number, color: number) {
    const geo = crearEngranaje(dientes, radio, radio * 0.18, 0.35);
    const g = new Group();
    g.add(new Mesh(geo, new MeshBasicMaterial({ color: ASFALTO, transparent: true, opacity: 0.85 })));
    g.add(new LineSegments(new EdgesGeometry(geo, 20), new LineBasicMaterial({ color })));
    return g;
  }

  /** Vórtice de partículas: puntos repartidos en espiral alrededor del centro. */
  function crearPortal(cantidad: number) {
    const posiciones: number[] = [];
    const colores: number[] = [];
    const c1 = new Color(VERDE);
    const c2 = new Color(NARANJA);
    for (let i = 0; i < cantidad; i++) {
      const radio = 2.2 + Math.random() * 2.6;
      const angulo = Math.random() * Math.PI * 2;
      posiciones.push(
        Math.cos(angulo) * radio,
        Math.sin(angulo) * radio,
        (Math.random() - 0.5) * 1.5,
      );
      // 1 de cada 8 partículas en naranja, como chispas
      const c = Math.random() < 0.125 ? c2 : c1;
      colores.push(c.r, c.g, c.b);
    }
    const geo = new BufferGeometry();
    geo.setAttribute("position", new Float32BufferAttribute(posiciones, 3));
    geo.setAttribute("color", new Float32BufferAttribute(colores, 3));
    const mat = new PointsMaterial({
      size: 0.035,
      vertexColors: true,
      transparent: true,
      opacity: 0.8,
      blending: AdditiveBlending, // los puntos que se solapan brillan más
      depthWrite: false,
    });
    return new Points(geo, mat);
  }

  function iniciar(contenedor: HTMLElement, canvas: HTMLCanvasElement) {
    // Si el navegador no soporta WebGL, simplemente no mostramos la escena.
    let renderer: WebGLRenderer;
    try {
      renderer = new WebGLRenderer({ canvas, antialias: true, alpha: true });
    } catch {
      contenedor.style.display = "none";
      return;
    }
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2)); // límite para no saturar pantallas 4K

    const escena = new Scene();
    const camara = new PerspectiveCamera(45, 1, 0.1, 100);
    camara.position.set(0, 0, 9);

    // Grupo principal: lo inclinamos con el ratón
    const mundo = new Group();
    escena.add(mundo);

    // Engranajes: 14 y 9 dientes. Para que "encajen", la distancia entre
    // centros es la suma de radios, y giran a velocidades inversas a sus dientes.
    const grande = engranaje(14, 1.5, VERDE);
    const chico = engranaje(9, 0.95, NARANJA);
    grande.position.set(-0.75, 0.35, 0);
    chico.position.set(1.55, -0.95, 0.05);
    mundo.add(grande, chico);

    const portal = crearPortal(1800);
    mundo.add(portal);

    // Ajusta el tamaño del canvas a su contenedor
    function redimensionar() {
      const { clientWidth: w, clientHeight: h } = contenedor;
      renderer.setSize(w, h, false);
      camara.aspect = w / h;
      // En pantallas estrechas alejamos la cámara para que quepa todo
      camara.position.z = w / h < 1 ? 11 : 9;
      camara.updateProjectionMatrix();
    }
    new ResizeObserver(redimensionar).observe(contenedor);
    redimensionar();

    // Posición del ratón normalizada entre -1 y 1
    const raton = { x: 0, y: 0 };
    window.addEventListener("pointermove", (e) => {
      raton.x = (e.clientX / window.innerWidth) * 2 - 1;
      raton.y = (e.clientY / window.innerHeight) * 2 - 1;
    });

    const reducirMovimiento = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Solo animamos cuando la escena está en pantalla (ahorra batería y CPU)
    let visible = true;
    new IntersectionObserver(([entrada]) => {
      if (reducirMovimiento) return;
      visible = entrada.isIntersecting;
      if (visible) bucle();
    }).observe(contenedor);

    let anterior = performance.now();
    let corriendo = false;

    function bucle() {
      if (corriendo) return;
      corriendo = true;
      const frame = (ahora: number) => {
        if (!visible || document.hidden) { corriendo = false; return; }
        const dt = Math.min((ahora - anterior) / 1000, 0.05); // segundos desde el frame anterior
        anterior = ahora;

        grande.rotation.z += dt * 0.4;
        chico.rotation.z -= dt * 0.4 * (14 / 9); // relación de transmisión
        portal.rotation.z += dt * 0.08;

        // "lerp": nos acercamos poco a poco al objetivo -> movimiento suave
        mundo.rotation.y += (raton.x * 0.35 - mundo.rotation.y) * 0.05;
        mundo.rotation.x += (raton.y * 0.25 - mundo.rotation.x) * 0.05;

        renderer.render(escena, camara);
        requestAnimationFrame(frame);
      };
      anterior = performance.now();
      requestAnimationFrame(frame);
    }

    if (reducirMovimiento) {
      // Sin animación: una sola imagen fija
      mundo.rotation.set(-0.15, 0.25, 0);
      renderer.render(escena, camara);
      visible = false;
    } else {
      bucle();
      document.addEventListener("visibilitychange", () => !document.hidden && bucle());
    }
  }

  if (contenedor && canvas) iniciar(contenedor, canvas);
</script>

---
import { site } from "../data/site";

const enlaces = [
  { href: "/#proyectos", texto: "proyectos" },
  { href: "/#sobre-mi", texto: "sobre_mí" },
  { href: "/#garaje", texto: "garaje" },
  { href: "/#contacto", texto: "contacto" },
];
---

<header class="sticky top-0 z-20 border-b border-borde bg-asfalto/80 backdrop-blur">
  <nav class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
    <a href="/" class="font-mono font-bold text-white" aria-label={`${site.nombre}, inicio`}>
      <span class="text-portal">~/</span>{site.usuario}
    </a>
    <!-- En móvil se esconden algunos enlaces (hidden) y aparecen desde sm: -->
    <ul class="flex gap-4 font-mono text-sm sm:gap-6">
      {enlaces.map((e, i) => (
        <li class={i === 1 || i === 2 ? "hidden sm:block" : ""}>
          <a href={e.href} class="text-humo transition hover:text-portal">{e.texto}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

---
// 404.astro: Astro genera 404.html y el hosting lo muestra
// automáticamente cuando alguien entra a una URL que no existe.
import Layout from "../layouts/Layout.astro";
import Barra from "../components/Barra.astro";
import { site } from "../data/site";
---

<Layout title="Página no encontrada">
  <div class="flex min-h-dvh flex-col">
    <main class="mx-auto flex w-full max-w-4xl flex-1 px-3 pt-8 pb-12 sm:px-4">
      <section class="panel w-full flex-1 justify-center p-6 pt-10 sm:p-12">
        <span class="ttl">bash — {site.usuario}@garaje</span>
        <p class="font-display text-[clamp(120px,28vw,280px)] leading-[0.8] font-black text-agua">404</p>
        <h1 class="mt-8 text-2xl font-semibold sm:text-3xl">Esta ruta se perdió en otra dimensión</h1>
        <p class="mt-4 max-w-md text-humo">
          O se quedó sin gasolina por el camino. En cualquier caso, aquí no hay nada.
        </p>
        <p class="mt-8 text-sm text-humo">
          <span class="text-agua">{site.usuario}@garaje:~$</span> cd /esta-ruta<br />
          <span class="text-motor">bash: cd: No existe el archivo o directorio</span>
        </p>
        <a href="/" class="mt-8 inline-flex min-h-12 w-fit items-center bg-agua px-6 text-sm font-semibold text-asfalto hover:brightness-110">cd ~</a>
      </section>
    </main>
    <Barra activa={0} />
  </div>
</Layout>

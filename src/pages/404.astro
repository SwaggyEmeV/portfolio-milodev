---
// 404.astro: Astro genera 404.html y el hosting lo muestra
// automáticamente cuando alguien entra a una URL que no existe.
import Layout from "../layouts/Layout.astro";
import Barra from "../components/Barra.astro";
import { site } from "../data/site";
---

<Layout title="Host no encontrado">
  <div class="flex min-h-dvh flex-col">
    <main class="mx-auto flex w-full max-w-4xl flex-1 px-3 pt-10 pb-12 sm:px-4">
      <section class="panel w-full flex-1 justify-center p-6 pt-10 sm:p-12">
        <span class="ttl">ping — {site.usuario}@{site.host}</span>
        <p class="glitch siempre font-display text-[clamp(110px,26vw,260px)] leading-[0.8] font-bold text-agua" data-text="404">404</p>
        <h1 class="mt-8 font-display text-2xl font-bold tracking-wide uppercase sm:text-3xl">Host no encontrado</h1>
        <p class="mt-4 max-w-md text-niebla">
          Esta ruta no responde. Puede que nunca existiera, o que alguien la borrara antes de que llegaras.
        </p>
        <p class="mt-8 text-sm text-niebla">
          <span class="text-agua">{site.usuario}@{site.host}:~$</span> ping /esta-ruta<br />
          <span class="text-alerta">ping: /esta-ruta: Nombre o servicio desconocido</span>
        </p>
        <a href="/" class="btn mt-8 w-fit">volver al mapa</a>
      </section>
    </main>
    <Barra />
  </div>
</Layout>

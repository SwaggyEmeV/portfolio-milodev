---
import Layout from "../layouts/Layout.astro";
import Terminal from "../components/Terminal.astro";
import { getCollection } from "astro:content";

// Proyectos: primero los destacados, luego los más recientes.
const proyectos = (await getCollection("proyectos")).sort(
  (a, b) =>
    Number(b.data.destacado) - Number(a.data.destacado) ||
    b.data.fecha.getTime() - a.data.fecha.getTime(),
);
---

<Layout>
  <Terminal proyectos={proyectos} />
</Layout>

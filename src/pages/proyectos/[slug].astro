---
// [slug] = ruta dinámica: una plantilla genera una página por proyecto.
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const proyectos = await getCollection("proyectos");
  return proyectos.map((p) => ({ params: { slug: p.id }, props: { proyecto: p } }));
}

const { proyecto } = Astro.props;
const { Content } = await render(proyecto);
const d = proyecto.data;
// timeZone "UTC": las fechas del Markdown se leen en UTC; sin esto, en zonas
// horarias de América el 1 de octubre se mostraría como 30 de septiembre.
const fecha = d.fecha.toLocaleDateString("es", { month: "long", year: "numeric", timeZone: "UTC" });
---

<Layout title={d.titulo} description={d.resumen}>
  <!-- data-escena="proyectos": la cámara 3D se queda dentro del túnel -->
  <article data-escena="proyectos" class="my-12 rounded-xl border border-borde bg-chasis/70 p-6 backdrop-blur-md sm:p-10">
    <a href="/#proyectos" class="font-mono text-sm text-humo transition hover:text-portal">← cd ..</a>

    <p class="mt-10 font-mono text-sm text-motor">./{proyecto.id} · {fecha}</p>
    <h1 class="mt-3 text-4xl font-bold text-white sm:text-5xl">{d.titulo}</h1>
    <p class="mt-4 max-w-2xl text-xl text-humo">{d.resumen}</p>

    <ul class="mt-6 flex flex-wrap gap-2 font-mono text-xs">
      {d.tecnologias.map((t) => (
        <li class="rounded border border-borde bg-chasis px-2 py-1 text-portal">{t}</li>
      ))}
    </ul>

    {(d.demo || d.repo) && (
      <div class="mt-8 flex flex-wrap gap-4 font-mono text-sm">
        {d.demo && <a href={d.demo} target="_blank" rel="noopener" class="rounded-lg bg-portal px-4 py-2 font-semibold text-asfalto hover:bg-portal-dark">ver_demo ↗</a>}
        {d.repo && <a href={d.repo} target="_blank" rel="noopener" class="rounded-lg border border-borde px-4 py-2 hover:border-portal hover:text-portal">código ↗</a>}
      </div>
    )}

    <!-- Estilos para el HTML que genera el Markdown: [&_h2]: apunta a los <h2> de dentro -->
    <div class="mt-12 max-w-2xl space-y-4 border-t border-borde pt-10 text-lg text-humo
                [&_code]:rounded [&_code]:bg-chasis [&_code]:px-1.5 [&_code]:font-mono [&_code]:text-sm [&_code]:text-motor
                [&_h2]:mt-10 [&_h2]:font-mono [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-white [&_h2]:before:text-portal [&_h2]:before:content-['#_']
                [&_li]:mt-1 [&_strong]:text-texto [&_ul]:list-['▹__'] [&_ul]:pl-6 [&_ul]:marker:text-portal">
      <Content />
    </div>
  </article>
</Layout>

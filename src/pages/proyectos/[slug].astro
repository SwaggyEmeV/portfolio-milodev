---
// [slug] = ruta dinámica: una plantilla genera una página por proyecto.
// Cada proyecto es un "expediente" del mapa de red.
import Layout from "../../layouts/Layout.astro";
import Barra from "../../components/Barra.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const proyectos = await getCollection("proyectos");
  return proyectos.map((p) => ({ params: { slug: p.id }, props: { proyecto: p } }));
}

const { proyecto } = Astro.props;
const { Content } = await render(proyecto);
const d = proyecto.data;
// timeZone "UTC": las fechas del Markdown se leen en UTC; sin esto, en zonas
// horarias de América el 1 de octubre se mostraría como 30 de septiembre.
const fecha = d.fecha.toLocaleDateString("es", { month: "long", year: "numeric", timeZone: "UTC" });
---

<Layout title={d.titulo} description={d.resumen}>
  <div class="flex min-h-dvh flex-col">
    <main class="mx-auto w-full max-w-4xl flex-1 px-3 pt-10 pb-12 sm:px-4">
      <article class="panel p-6 pt-10 sm:p-10 sm:pt-12">
        <span class="ttl">expediente · {proyecto.id}</span>

        <div class="flex flex-wrap items-center justify-between gap-3 text-xs">
          <a href="/#proyectos" class="text-niebla transition hover:text-agua">← volver al mapa</a>
          <span class="text-niebla">acceso: <span class="text-agua">público</span> · {fecha}</span>
        </div>

        <p class="mt-10 text-sm text-agua">// ./{proyecto.id}</p>
        <h1 data-descifrar class="mt-3 font-display text-4xl leading-[0.95] font-bold uppercase sm:text-6xl">{d.titulo}</h1>
        <p data-descifrar class="mt-5 max-w-2xl text-lg text-niebla">{d.resumen}</p>

        <ul class="mt-6 flex flex-wrap gap-2 text-xs">
          {d.tecnologias.map((t) => (
            <li class="border border-borde px-2 py-1 text-agua">{t}</li>
          ))}
        </ul>

        {(d.demo || d.repo) && (
          <div class="mt-8 flex flex-wrap gap-3">
            {d.demo && <a href={d.demo} target="_blank" rel="noopener" class="btn">ver demo ↗</a>}
            {d.repo && <a href={d.repo} target="_blank" rel="noopener" class="btn-sec">código ↗</a>}
          </div>
        )}

        <!-- Estilos para el HTML que genera el Markdown: [&_h2]: apunta a los <h2> de dentro -->
        <div class="mt-12 max-w-2xl space-y-4 border-t border-borde pt-10 text-base leading-relaxed text-niebla
                    [&_code]:bg-borde [&_code]:px-1.5 [&_code]:text-sm [&_code]:text-agua
                    [&_h2]:mt-10 [&_h2]:font-display [&_h2]:text-xl [&_h2]:font-bold [&_h2]:tracking-wide [&_h2]:text-luz [&_h2]:uppercase [&_h2]:before:text-agua [&_h2]:before:content-['//_']
                    [&_li]:mt-1 [&_strong]:text-luz [&_ul]:list-['▹__'] [&_ul]:pl-6 [&_ul]:marker:text-agua">
          <Content />
        </div>
      </article>
    </main>
    <Barra activa="proyectos" />
  </div>
</Layout>

<script>
  import { descifrar } from "../../scripts/scramble";
  document.querySelectorAll<HTMLElement>("[data-descifrar]").forEach((el) => descifrar(el, 800));
</script>

---
// Lo que va entre "---" se ejecuta al COMPILAR. Lo de abajo es el HTML generado.
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Hud from "../components/Hud.astro";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}
const { title, description = site.frase } = Astro.props;
const fullTitle = title ? `${title} | ${site.nombre}` : `${site.nombre} | ${site.rol}`;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0f0c" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{fullTitle}</title>
    <!-- is:inline = se ejecuta tal cual y al instante, antes de pintar la página -->
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body class="relative min-h-screen bg-asfalto font-sans text-texto antialiased">
    <!-- Fondo de respaldo (si no hay WebGL): rejilla sutil + brillo verde -->
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-20 overflow-hidden">
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#1f2b2333_1px,transparent_1px),linear-gradient(to_bottom,#1f2b2333_1px,transparent_1px)] bg-[size:48px_48px]"></div>
      <div class="absolute -top-40 left-1/2 h-[480px] w-[480px] -translate-x-1/2 rounded-full bg-portal/10 blur-3xl"></div>
    </div>

    <!-- La escena 3D de toda la página (la dibuja src/scripts/escena.ts) -->
    <canvas data-escena-canvas aria-hidden="true" class="escena pointer-events-none fixed inset-0 -z-10 h-screen w-screen"></canvas>
    <!-- Viñeta: oscurece los bordes para que el texto se lea mejor -->
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-[5] bg-[radial-gradient(ellipse_at_center,transparent_40%,#0a0f0cb3_100%)]"></div>
    <!-- Líneas de escaneo tipo monitor CRT -->
    <div aria-hidden="true" class="scanlines pointer-events-none fixed inset-0 z-50"></div>

    <Header />
    <main class="mx-auto max-w-5xl px-4 sm:px-6">
      <slot />
    </main>
    <Footer />
    <Hud />

    <script>
      import { iniciarEfectos } from "../scripts/efectos";
      iniciarEfectos();
    </script>
  </body>
</html>

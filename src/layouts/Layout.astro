---
// Todo lo que va entre las líneas "---" se ejecuta al COMPILAR (como el PHP
// de arriba de un archivo). Lo de abajo es el HTML que se genera.
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";

// "Props": los datos que recibe este layout desde cada página.
interface Props {
  title?: string;
  description?: string;
}
const { title, description = site.frase } = Astro.props;
const fullTitle = title ? `${title} | ${site.nombre}` : `${site.nombre} | ${site.rol}`;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
  </head>
  <!-- dark:  aplica la clase solo si el sistema está en modo oscuro -->
  <body class="min-h-screen bg-white font-sans text-slate-800 antialiased dark:bg-slate-950 dark:text-slate-200">
    <Header />
    <main class="mx-auto max-w-5xl px-4 sm:px-6">
      <!-- <slot /> es el hueco donde cada página mete su contenido -->
      <slot />
    </main>
    <Footer />
  </body>
</html>
